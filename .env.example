# Settings for the `account-registry` CLI and the `account_publish` example.
#
#   cp .env.example .env    # then edit .env in an editor
#   chmod 600 .env
#   source .env
#
# `.env` is ignored by git. It holds keys in plain text: use it for test networks only, and keep
# one file per network.

# The sequencer's JSON-RPC URL. Defaults to a local sequencer, http://localhost:3040.
export SEQUENCER_URL=https://testnet.lez.logos.co

# The registry's program account, base58: what `account-registry deploy` prints. Needed to fetch
# and to publish, not to deploy. Uncomment once it is known.
# export ACCOUNT_REGISTRY_PROGRAM=

# The fee payer's key, hex. A secret: whoever holds it can spend the payer's balance.
export ACCOUNT_REGISTRY_PAYER=

# The program account's key, hex, needed only to deploy. A secret: whoever holds it can replace
# the program.
export ACCOUNT_REGISTRY_PROGRAM_KEY=
