# The relay's funded payer key, 64 hex characters. Required.
ACCOUNT_REGISTRY_PAYER=

# A LEZ v0.4 sequencer and the registry deployed there, base58. Required: the public testnet
# runs LEZ v0.3 until it moves to v0.4, and a v0.4 relay cannot talk to it.
SEQUENCER_URL=
ACCOUNT_REGISTRY_PROGRAM=

# open, or token with ACCOUNT_RELAY_TOKEN.
# ACCOUNT_RELAY_AUTH=open
# ACCOUNT_RELAY_TOKEN=

# Updates per existing account a day; a new account's first log is always sponsored.
# ACCOUNT_RELAY_MAX_APPENDS_PER_DAY=2
# ACCOUNT_RELAY_MAX_PER_HOUR=30
# ACCOUNT_RELAY_MAX_PER_DAY=200
# ACCOUNT_RELAY_MAX_LOG_BYTES=4096
# ACCOUNT_RELAY_MIN_BALANCE=70000000

# Monitoring: Prometheus scrapes the relay; Grafana serves the Account Relay dashboard on 127.0.0.1.
# GRAFANA_PORT=3000
# GRAFANA_ADMIN_USER=admin
# GRAFANA_ADMIN_PASSWORD=admin
# PROMETHEUS_RETENTION=30d
