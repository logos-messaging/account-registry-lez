# The relay's funded payer key, 64 hex characters. Required.
ACCOUNT_REGISTRY_PAYER=

# Defaults: the public testnet and the registry deployed there.
# SEQUENCER_URL=https://testnet.lez.logos.co
# ACCOUNT_REGISTRY_PROGRAM=BHNNfnhPMNMZ7N3oAtbu1iM1HkFyraWx2UjBvxhj8wTa

# open, or token with ACCOUNT_RELAY_TOKEN.
# ACCOUNT_RELAY_AUTH=open
# ACCOUNT_RELAY_TOKEN=

# Updates per existing account a day; a new account's first log is always sponsored.
# ACCOUNT_RELAY_MAX_APPENDS_PER_DAY=2
# ACCOUNT_RELAY_MAX_PER_HOUR=30
# ACCOUNT_RELAY_MAX_PER_DAY=200
