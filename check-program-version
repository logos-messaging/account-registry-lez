#!/usr/bin/env bash
#
# The crates compiled into the guest share one program version, and it moves when they change:
# a crate's version is part of the image, so the image ID follows it.

set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")"
program=account-registry-lezprogram
manifests=("$program/core/Cargo.toml" "$program/program/Cargo.toml" "$program/methods/guest/Cargo.toml")

version_of() {
    sed -n '/^version = "\(.*\)"$/{s//\1/p;q;}'
}

# Whether version $1 comes after $2. A pre-release such as 0.4.0-rc.1 comes before 0.4.0.
newer() {
    local a_core=${1%%-*} b_core=${2%%-*}
    if [[ $a_core != "$b_core" ]]; then
        [[ $(printf '%s\n' "$a_core" "$b_core" | sort -V | tail -1) == "$a_core" ]]
    elif [[ $1 == "$a_core" ]]; then
        [[ $2 != "$b_core" ]]
    elif [[ $2 == "$b_core" ]]; then
        return 1
    else
        [[ $(printf '%s\n' "$1" "$2" | sort -V | tail -1) == "$1" ]]
    fi
}

version=$(version_of < "${manifests[0]}")
for manifest in "${manifests[@]}"; do
    found=$(version_of < "$manifest")
    if [[ -z $found || $found != "$version" ]]; then
        echo "check-program-version: $manifest is at '${found}', ${manifests[0]} at '$version'" >&2
        exit 1
    fi
done

if [[ -z $(git tag --list 'v*') ]]; then
    exit 0
fi
if ! tag=$(git describe --tags --abbrev=0 --match 'v*' 2>/dev/null); then
    echo "check-program-version: no release tag is reachable; is the checkout shallow?" >&2
    exit 1
fi

inputs=(
    "$program/core"
    "$program/program"
    "$program/methods/guest"
    "$program/methods/build.rs"
    ":(exclude)$program/program/src/tests.rs"
)
if git diff --quiet "$tag" -- "${inputs[@]}"; then
    exit 0
fi
released=$(git show "$tag:${manifests[0]}" | version_of)
if [[ $released == "$version" ]] || ! newer "$version" "$released"; then
    echo "check-program-version: the program changed since $tag ($released) but is at $version" >&2
    exit 1
fi
