#!/usr/bin/env bash
#
# Runs a local LEZ sequencer at the exact revision this workspace pins.
#
# Needs no separate clone of the upstream repository. Cargo has already fetched it to satisfy
# this workspace's git dependencies, so the sequencer is built from the same checkout the client
# and the program were compiled against. That is the point: a LEZ program is bound to the
# protocol revision it was built for, and a hand-cloned upstream is one `git checkout` away from
# silently disagreeing with the pin in Cargo.toml.
#
# Genesis funds the client's local payer (`LOCAL_PAYER_KEY` in account-registry-client), since
# every write pays a fee and nothing can mint native balance once the chain is running.
#
# Usage: ./run-local-sequencer [extra sequencer args]

set -euo pipefail

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
cargo_home=${CARGO_HOME:-$HOME/.cargo}

# Must match `LOCAL_PAYER_PUBLIC_KEY` in account-registry-cli/src/main.rs: genesis names a funded
# account by its public key.
local_payer_key=4f355bdcb7cc0af728ef3cceb9615d90684bb5b2ca5f859ab0f0b704075871aa

# A key the mocked Bedrock node needs named, as upstream's Justfile does; it holds nothing here.
bedrock_funding_key=2e03b2eff5a45478e7e79668d2a146cf2c5c7925bce927f2b1c67f2ab4fc0d26

# Cargo.toml pins a tag; Cargo.lock records the commit it resolved to.
tag=$(sed -n 's/.*logos-execution-zone", tag = "\([^"]*\)".*/\1/p' "$repo_root/Cargo.toml" | head -1)
locked_rev() {
    sed -n "s/.*logos-execution-zone?tag=${tag}#\([0-9a-f]\{7,\}\)\".*/\1/p" \
        "$repo_root/Cargo.lock" 2>/dev/null | head -1
}
rev=$(locked_rev)
if [[ -z $rev ]]; then
    (cd "$repo_root" && cargo fetch)
    rev=$(locked_rev)
fi

if [[ -z $rev ]]; then
    echo "run-local-sequencer: no logos-execution-zone revision found in Cargo.lock" >&2
    exit 1
fi

# Cargo names a checkout by the revision's short hash, under a directory whose suffix hashes the
# source URL — so both halves are discovered rather than hardcoded.
find_checkout() {
    find "$cargo_home/git/checkouts" -maxdepth 2 -type d -name "${rev:0:7}" \
        -path '*logos-execution-zone*' 2>/dev/null | head -1 || true
}

checkout=$(find_checkout)

if [[ -z $checkout ]]; then
    echo "Fetching the pinned upstream revision (${rev:0:7})..." >&2
    (cd "$repo_root" && cargo fetch)
    checkout=$(find_checkout)
fi

if [[ -z $checkout ]]; then
    echo "run-local-sequencer: no checkout of ${rev:0:7} under $cargo_home/git/checkouts" >&2
    echo "  \`cargo fetch\` in $repo_root should create one." >&2
    exit 1
fi

service="$checkout/lez/sequencer/service"

if [[ ! -d $service ]]; then
    echo "run-local-sequencer: $service is missing — is the pin still a LEZ revision?" >&2
    exit 1
fi

# Build artefacts go outside the checkout: cargo treats its cache as disposable and may prune
# it, and a release target directory there would be both large and liable to vanish. One per
# revision: cargo reuses stale crates when two revisions share a target directory.
export CARGO_TARGET_DIR=${CARGO_TARGET_DIR:-$repo_root/target/sequencer-${rev:0:7}}

# `standalone` mocks the Bedrock node, so no Docker. RISC0_DEV_MODE skips proof verification,
# which is what makes iteration bearable — never set it for anything you mean to trust.
export RISC0_DEV_MODE=${RISC0_DEV_MODE:-1}
export RUST_LOG=${RUST_LOG:-info}

home="$CARGO_TARGET_DIR/home"
mkdir -p "$CARGO_TARGET_DIR"
cd "$checkout"

# `setup` writes the home once; the chain's state then lives there. Delete it to start over.
if [[ ! -f $home/sequencer_config.json ]]; then
    config="$CARGO_TARGET_DIR/local.json"
    python3 - "$service/networks/local.json" "$config" "$local_payer_key" <<'EOF'
import json, sys
source, target, payer = sys.argv[1:]
config = json.load(open(source))
recipient = {"identified": {"key": payer}}
config["genesis"]["actions"].append({"supply_account": {"recipient": recipient, "balance": 10**13}})
json.dump(config, open(target, "w"), indent=2)
EOF
    cargo run --release -q --features standalone -p sequencer_service -- setup "$home" --config "$config" \
        --funding-public-key "$bedrock_funding_key" --create-channel
fi

echo "Sequencer at ${rev:0:7}, binding :3040, local payer funded, state in $home. Ctrl-C to stop." >&2

exec cargo run --release --features standalone -p sequencer_service -- start "$home" "$@"
